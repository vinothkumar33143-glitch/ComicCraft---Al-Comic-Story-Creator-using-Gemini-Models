APP_NAME=ComicCraft
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# mock = no external AI calls; useful for UI/API development
# gemini = real Gemini text generation
AI_MODE=mock

GEMINI_API_KEY=
GEMINI_OUTLINE_MODEL=gemini-3.6-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview

# placeholder = instant generated SVG/PNG-like comic placeholders
# diffusers = local Hugging Face Diffusers Stable Diffusion
IMAGE_PROVIDER=placeholder
DIFFUSION_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_TOKEN=

PANEL_COUNT=5
IMAGE_WIDTH=768
IMAGE_HEIGHT=512
